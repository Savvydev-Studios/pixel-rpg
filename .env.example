# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore). Never commit real credentials, and
# never paste a key directly into a .py file - the code reads every secret
# through os.environ.get() in pixel_rpg/config.py.

# ---------------------------------------------------------------------------
# Optional credential.
# The game is fully playable offline and does NOT need this. It exists for the
# optional online extras (leaderboard submission, seed-of-the-day). When it is
# absent or still set to the placeholder below, those features stay switched
# off rather than failing.
# ---------------------------------------------------------------------------
API_KEY=YOUR_API_KEY_HERE

# ---------------------------------------------------------------------------
# Gameplay and display settings. All optional; every value is validated and
# clamped on load, so a typo degrades gracefully instead of crashing.
# ---------------------------------------------------------------------------
PIXEL_RPG_WIDTH=1280
PIXEL_RPG_HEIGHT=720
PIXEL_RPG_FPS=60
PIXEL_RPG_TILE=32
PIXEL_RPG_FULLSCREEN=false

# 0.0 to 1.0
PIXEL_RPG_VOLUME=0.55
PIXEL_RPG_SFX=true

# story | normal | hard | nightmare
PIXEL_RPG_DIFFICULTY=normal

# Fixed integer for a reproducible world; leave blank for a random one.
PIXEL_RPG_SEED=

PIXEL_RPG_SHOW_FPS=false
PIXEL_RPG_DEBUG=false

# Where save slots live. Defaults to your OS application-data directory,
# deliberately outside the repository so saves are never staged for commit.
PIXEL_RPG_SAVE_DIR=

# ---------------------------------------------------------------------------
# The global leaderboard (roadmap item 0az). BOTH are optional and the game
# is complete without them: leave the URL blank and there is simply no global
# board, which is the state every shipped build is in.
#
# Savvydev, 2026-09-06, on what the constraint actually is:
#
#   "i dont want ALL global servers running off of my pc, but you can still
#    use FREE 3rd party tools for the global stuff"
#
# So point this at somebody else's free service - anything that answers
# GET /scores?mode=&party=&limit= and POST /scores with JSON. Nothing of ours
# runs anywhere, and this key never appears in a source file.
PIXEL_RPG_BOARD_URL=
PIXEL_RPG_BOARD_KEY=YOUR_API_KEY_HERE

# ---------------------------------------------------------------------------
# Optional co-op relay (s85). Leave it empty and nothing about it exists:
# rooms are direct and a room code is an address, which is how co-op has
# always worked and needs no server at all.
#
# It exists for one situation: a host whose connection has no address of its
# own. Carrier-grade NAT - most phone tethering, and a lot of home broadband -
# hands a whole neighbourhood one public IP with no way to forward a port, so
# the room code comes out looking fine and nobody can connect to it. With this
# set, the host dials OUT to the relay instead of listening, and room codes
# become six characters rather than ten.
#
# Run your own: `python tools/relay_server.py --port 8080` on anything with a
# public address. Both machines need the same URL - the code says which room,
# not which relay.
#
# WHOEVER RUNS THE RELAY SEES EVERYTHING THE ROOM SENDS. It is a pipe in the
# middle, not an encrypted tunnel. Nothing secret crosses it (positions,
# monsters, a serialised hero) but that is a fact about the game rather than
# a promise the relay makes.
PIXEL_RPG_RELAY_URL=
